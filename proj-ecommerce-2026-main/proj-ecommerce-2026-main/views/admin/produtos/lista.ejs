<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Roteiros | Takes</title>
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">
</head>

<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/admin/index">
                TAKES
            </a>
            <a href="/admin/index" class="btn btn-outline-light btn-sm">
                Painel
            </a>
        </div>
    </nav>

    <main class="container py-5">
        <div class="d-flex justify-content-between align-items-center
                    flex-wrap gap-3 mb-4">
            <div>
                <h1 class="h2">Roteiros cadastrados</h1>
                <p class="text-secondary mb-0">
                    Gerencie os roteiros do catálogo Takes.
                </p>
            </div>

            <a href="/admin/produtos/form-cadastrar"
               class="btn btn-warning">
                + Cadastrar roteiro
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-striped table-hover
                              align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Roteiro</th>
                            <th>Formato</th>
                            <th>Gênero</th>
                            <th>Preço</th>
                            <th>Estoque</th>
                            <th>Capa</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (produtos.length === 0) { %>
                            <tr>
                                <td colspan="7" class="text-center p-4">
                                    Nenhum roteiro cadastrado.
                                </td>
                            </tr>
                        <% } %>

                        <% produtos.forEach(produto => { %>
                            <tr>
                                <td><%= produto.id %></td>
                                <td>
                                    <strong><%= produto.nome %></strong>
                                    <div class="small text-secondary">
                                        <%= produto.descricao || '' %>
                                    </div>
                                </td>
                                <td>
                                    <%= produto.nome_categoria ||
                                        produto.categoria || '-' %>
                                </td>
                                <td><%= produto.genero || '-' %></td>
                                <td>
                                    R$ <%= Number(produto.valor || 0)
                                        .toFixed(2).replace('.', ',') %>
                                </td>
                                <td><%= produto.estoque %></td>
                                <td>
                                    <% if (produto.imagem) { %>
                                        <img
                                            src="/uploads/<%= produto.imagem %>"
                                            alt="Capa de <%= produto.nome %>"
                                            style="width: 60px; height: 80px;
                                                   object-fit: cover;">
                                    <% } else { %>
                                        <span class="text-secondary">
                                            Sem capa
                                        </span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>

        <a href="/admin/index"
           class="btn btn-outline-secondary mt-3">
            Voltar ao painel
        </a>
    </main>
</body>
</html>
