
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Editar Categoria | TAKES</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<main class="container py-5">
    <div class="card shadow-sm mx-auto" style="max-width:650px;">

        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">Editar categoria</h4>
        </div>

        <div class="card-body">
            <form action="/admin/categorias/editar/<%= categoria.id %>"
                  method="POST">

                <div class="mb-3">
                    <label class="form-label">Nome</label>
                    <input type="text" name="nome"
                           class="form-control"
                           value="<%= categoria.nome %>" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Descrição</label>
                    <textarea name="descricao" class="form-control"
                              rows="4"><%= categoria.descricao || '' %></textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    Salvar alterações
                </button>

                <a href="/admin/categorias" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>
        </div>
    </div>
</main>

</body>
</html>
