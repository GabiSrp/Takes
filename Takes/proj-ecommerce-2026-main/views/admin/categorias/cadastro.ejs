
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Cadastrar formato | Takes</title>
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">
</head>

<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/admin/index">
                TAKES
            </a>
        </div>
    </nav>

    <main class="container py-5">
        <div class="card shadow-sm mx-auto" style="max-width: 650px;">
            <div class="card-body p-4">
                <h1 class="h3">Cadastrar formato de roteiro</h1>
                <p class="text-secondary">
                    Ex.: longa-metragem, curta-metragem ou série.
                </p>

                <form action="/admin/categorias/cadastrar" method="POST">
                    <div class="mb-3">
                        <label for="nome" class="form-label">
                            Nome do formato
                        </label>
                        <input type="text" id="nome" name="nome"
                               class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label for="descricao" class="form-label">
                            Descrição
                        </label>
                        <textarea id="descricao" name="descricao"
                                  class="form-control" rows="4"></textarea>
                    </div>

                    <button type="submit" class="btn btn-warning">
                        Cadastrar formato
                    </button>

                    <a href="/admin/categorias"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </form>
            </div>
        </div>
    </main>
</body>
</html>
