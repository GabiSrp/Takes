
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Publicar roteiro | TAKES</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

        :root {
            --bg: #050607;
            --sidebar: #0b0d10;
            --surface: #101216;
            --surface-2: #151820;
            --border: #292d36;
            --text: #f4f5f8;
            --muted: #9298a5;
            --blue: #568bfa;
            --blue-hover: #4078ed;
            --radius: 14px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            font-size: 14px;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button,
        input,
        select,
        textarea {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        button:focus-visible,
        a:focus-visible,
        input:focus-visible,
        select:focus-visible,
        textarea:focus-visible {
            outline: 2px solid var(--blue);
            outline-offset: 3px;
        }

        /* LAYOUT */

        .layout {
            display: grid;
            grid-template-columns: 220px minmax(0, 1fr);
            min-height: 100vh;
        }

        /* SIDEBAR */

        .sidebar {
            position: sticky;
            top: 0;
            height: 100vh;
            padding: 40px 24px;
            background: var(--sidebar);
            border-right: 1px solid var(--border);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 0 0 85px 10px;
            font-size: 26px;
            font-weight: 800;
            white-space: nowrap;
        }

        .logo i {
            font-size: 24px;
        }

        .menu {
            display: flex;
            flex-direction: column;
            gap: 11px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 18px;
            padding: 12px 14px;
            min-height: 46px;
            border-radius: 30px;
            color: #d0d2d9;
            transition: .2s ease;
        }

        .menu-item i {
            display: inline-flex;
            justify-content: center;
            width: 25px;
            font-size: 22px;
        }

        .menu-item:hover,
        .menu-item.active {
            background: linear-gradient(100deg, #568bfa, #263249);
            color: #fff;
        }

        /* CONTEÚDO */

        .main {
            min-width: 0;
            padding: 30px 45px 70px;
            max-width: 1750px;
            width: 100%;
            margin: 0 auto;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 45px;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--muted);
            font-size: 12px;
        }

        .breadcrumb a:hover {
            color: white;
        }

        .breadcrumb i {
            font-size: 11px;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #b5bfcd;
            font-size: 12px;
            transition: color .2s;
        }

        .back-link:hover {
            color: var(--blue);
        }

        /* TÍTULO */

        .page-heading {
            margin-bottom: 36px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 14px;
            color: var(--blue);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.7px;
        }

        .page-heading h1 {
            font-size: clamp(29px, 3vw, 43px);
            font-weight: 800;
            letter-spacing: -1.5px;
            line-height: 1.15;
            margin-bottom: 12px;
        }

        .page-heading h1 span {
            color: var(--blue);
        }

        .page-heading p {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.7;
            max-width: 620px;
        }

        /* GRID */

        .content-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.6fr) minmax(290px, 0.85fr);
            align-items: start;
            gap: 26px;
        }

        /* FORMULÁRIO */

        .form-card {
            min-width: 0;
            background: #0d0f13;
            border: 1px solid var(--border);
            border-radius: 18px;
            overflow: hidden;
        }

        .form-section {
            padding: 30px;
            border-bottom: 1px solid var(--border);
        }

        .form-section:last-of-type {
            border-bottom: none;
        }

        .section-header {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            margin-bottom: 27px;
        }

        .section-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            width: 39px;
            height: 39px;
            border: 1px solid #30466c;
            border-radius: 11px;
            background: #17243b;
            color: var(--blue);
            font-size: 18px;
        }

        .section-header h2 {
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .section-header p {
            font-size: 12px;
            line-height: 1.5;
            color: var(--muted);
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 9px;
            min-width: 0;
            margin-bottom: 22px;
        }

        .field:last-child {
            margin-bottom: 0;
        }

        .field label {
            color: #e6e9f0;
            font-size: 12px;
            font-weight: 600;
        }

        .required {
            color: var(--blue);
        }

        .field input,
        .field select,
        .field textarea {
            width: 100%;
            min-width: 0;
            padding: 14px 16px;
            border: 1px solid #303641;
            border-radius: 10px;
            background: #151820;
            color: white;
            font-size: 13px;
            outline: none;
            transition: border-color .2s, box-shadow .2s;
        }

        .field input,
        .field select {
            height: 49px;
        }

        .field textarea {
            min-height: 155px;
            resize: vertical;
            line-height: 1.7;
        }

        .field input::placeholder,
        .field textarea::placeholder {
            color: #777f8e;
        }

        .field input:focus,
        .field select:focus,
        .field textarea:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px rgba(86,139,250,.11);
        }

        .field select {
            cursor: pointer;
        }

        .field select option {
            background: #151820;
            color: white;
        }

        .field-hint {
            font-size: 11px;
            color: #818998;
            line-height: 1.5;
        }

        .field-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
        }

        .field-grid .field {
            margin-bottom: 22px;
        }

        .textarea-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-top: 8px;
        }

        .counter {
            color: #8692a3;
            font-size: 11px;
            white-space: nowrap;
        }

        /* UPLOAD */

        .upload-area {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-height: 160px;
            padding: 22px;
            border: 1.5px dashed #435169;
            border-radius: 13px;
            background: #111824;
            text-align: center;
            cursor: pointer;
            transition: .25s ease;
        }

        .upload-area:hover,
        .upload-area.dragging {
            border-color: var(--blue);
            background: #16233a;
        }

        .upload-area > i {
            font-size: 32px;
            color: var(--blue);
        }

        .upload-area strong {
            font-size: 13px;
            font-weight: 600;
        }

        .upload-area span {
            font-size: 11px;
            color: var(--muted);
        }

        .upload-area input {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
        }

        .file-name {
            margin-top: 12px;
            color: #8db4ff;
            font-size: 12px;
            overflow-wrap: anywhere;
        }

        /* AÇÕES */

        .form-actions {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            padding: 24px 30px;
            border-top: 1px solid var(--border);
        }

        .btn-cancel,
        .btn-publish {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            min-height: 47px;
            padding: 12px 21px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            transition: .2s ease;
        }

        .btn-cancel {
            background: #171a20;
            color: #d0d3dc;
            border: 1px solid #343945;
        }

        .btn-cancel:hover {
            background: #242832;
            color: white;
        }

        .btn-publish {
            color: white;
            border: 1px solid #699cff;
            background: var(--blue);
        }

        .btn-publish:hover {
            background: var(--blue-hover);
            transform: translateY(-2px);
        }

        .btn-publish:disabled {
            cursor: wait;
            opacity: .65;
            transform: none;
        }

        /* PRÉVIA */

        .preview-column {
            position: sticky;
            top: 24px;
            min-width: 0;
        }

        .preview-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 17px;
        }

        .preview-heading h2 {
            font-size: 15px;
            font-weight: 700;
        }

        .preview-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #91a7cc;
            font-size: 10px;
            border: 1px solid #344058;
            background: #141c2a;
            padding: 7px 10px;
            border-radius: 20px;
        }

        .preview-label i {
            color: var(--blue);
        }

        .preview-card {
            overflow: hidden;
            border: 1px solid #303642;
            border-radius: 16px;
            background: #101318;
        }

        .poster {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            aspect-ratio: 16 / 10;
            max-height: 270px;
            overflow: hidden;
            background: linear-gradient(
                145deg,
                #101725,
                #1b3458 55%,
                #0b111b
            );
        }

        .poster img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .poster-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 13px;
            color: #a5bad7;
            text-align: center;
        }

        .poster-placeholder i {
            font-size: 39px;
        }

        .poster-placeholder span {
            font-size: 10px;
            letter-spacing: 2.5px;
        }

        .preview-content {
            padding: 20px;
        }

        .preview-content h3 {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 7px;
            line-height: 1.4;
            overflow-wrap: anywhere;
        }

        .preview-author {
            display: flex;
            align-items: center;
            gap: 7px;
            color: #989fab;
            font-size: 11px;
            margin-bottom: 14px;
        }

        .preview-description {
            color: #a3abb8;
            font-size: 12px;
            line-height: 1.7;
            margin-bottom: 16px;
            overflow-wrap: anywhere;

            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 3;
            line-clamp: 3;
            overflow: hidden;
        }

        .preview-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 19px;
        }

        .preview-tags span {
            border: 1px solid #3b4351;
            border-radius: 20px;
            padding: 5px 10px;
            font-size: 10px;
            color: #ced3dc;
        }

        .preview-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 17px;
            border-top: 1px solid #2b3039;
        }

        .preview-price {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .preview-price small {
            color: var(--muted);
            font-size: 10px;
        }

        .preview-price strong {
            font-size: 20px;
            color: #f2f4f8;
        }

        .preview-view {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--blue);
            font-size: 12px;
            font-weight: 600;
        }

        .preview-note {
            display: flex;
            align-items: flex-start;
            gap: 11px;
            margin-top: 19px;
            padding: 16px;
            border: 1px solid #2c3850;
            border-radius: 12px;
            background: #101824;
            color: #a8b8d1;
            font-size: 11px;
            line-height: 1.7;
        }

        .preview-note i {
            color: var(--blue);
            font-size: 17px;
        }

        /* RESPONSIVIDADE */

        @media (max-width: 1150px) {
            .main {
                padding: 28px 25px 50px;
            }

            .content-grid {
                grid-template-columns: 1fr;
            }

            .preview-column {
                position: static;
                max-width: 650px;
            }
        }

        @media (max-width: 850px) {
            .layout {
                grid-template-columns: 1fr;
            }

            .sidebar {
                height: auto;
                position: relative;
                padding: 20px;
            }

            .logo {
                margin-bottom: 20px;
            }

            .menu {
                flex-direction: row;
                flex-wrap: wrap;
            }
        }

        @media (max-width: 600px) {
            .main {
                padding: 22px 16px 40px;
            }

            .topbar {
                align-items: flex-start;
                flex-direction: column;
                margin-bottom: 32px;
            }

            .page-heading {
                margin-bottom: 26px;
            }

            .field-grid {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .form-section {
                padding: 22px 18px;
            }

            .form-actions {
                padding: 20px 18px;
            }

            .btn-cancel,
            .btn-publish {
                flex: 1;
            }
        }
    </style>
</head>

<body>

<div class="layout">

    <!-- MENU LATERAL -->
    <aside class="sidebar">

        <a href="/" class="logo">
            TAKES
            <i class="bi bi-camera-reels-fill"></i>
        </a>

        <nav class="menu">

            <a href="/roteiros" class="menu-item">
                <i class="bi bi-house-door"></i>
                <span>Início</span>
            </a>

            <a href="/perfil" class="menu-item">
                <i class="bi bi-person"></i>
                <span>Perfil</span>
            </a>

            <a href="/favoritos" class="menu-item">
                <i class="bi bi-star"></i>
                <span>Favoritos</span>
            </a>

            <a href="/admin" class="menu-item active">
                <i class="bi bi-grid"></i>
                <span>Painel Admin</span>
            </a>

        </nav>

    </aside>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="main">

        <header class="topbar">

            <div class="breadcrumb">
                <a href="/admin">Painel Admin</a>
                <i class="bi bi-chevron-right"></i>

                <a href="/admin/produtos">Roteiros</a>
                <i class="bi bi-chevron-right"></i>

                <span>Publicar</span>
            </div>

            <a href="/admin/produtos" class="back-link">
                <i class="bi bi-arrow-left"></i>
                Voltar aos roteiros
            </a>

        </header>

        <!-- TÍTULO -->
        <section class="page-heading">

            <span class="eyebrow">
                <i class="bi bi-stars"></i>
                CRIE. COMPARTILHE. INSPIRE.
            </span>

            <h1>Publique seu roteiro<span>.</span></h1>

            <p>
                Transforme sua ideia em uma oportunidade.
                Preencha as informações abaixo para adicionar
                seu projeto ao catálogo do TAKES.
            </p>

        </section>

        <div class="content-grid">

            <!-- FORMULÁRIO -->
            <form
                id="formRoteiro"
                class="form-card"
                action="/admin/produtos/cadastrar"
                method="POST"
                enctype="multipart/form-data">

                <!-- SEÇÃO 1 -->
                <section class="form-section">

                    <div class="section-header">

                        <div class="section-icon">
                            <i class="bi bi-film"></i>
                        </div>

                        <div>
                            <h2>Informações do projeto</h2>
                            <p>
                                Comece pelos dados principais
                                da sua história.
                            </p>
                        </div>

                    </div>

                    <div class="field">

                        <label for="nome">
                            Título do roteiro
                            <span class="required">*</span>
                        </label>

                        <input
                            type="text"
                            id="nome"
                            name="nome"
                            maxlength="200"
                            placeholder="Ex.: Everything You Can See"
                            required>

                        <small class="field-hint">
                            Escolha um título marcante
                            que represente seu roteiro.
                        </small>

                    </div>

                    <div class="field-grid">

                        <div class="field">

                            <label for="categoria">
                                Formato audiovisual
                                <span class="required">*</span>
                            </label>

                            <select
                                id="categoria"
                                name="categoria"
                                required>

                                <option value="">
                                    Selecione um formato
                                </option>

                                <% categorias.forEach(categoria => { %>
                                    <option value="<%= categoria.nome %>">
                                        <%= categoria.nome %>
                                    </option>
                                <% }); %>

                            </select>

                        </div>

                        <div class="field">

                            <label for="genero">
                                Gênero narrativo
                                <span class="required">*</span>
                            </label>

                            <select
                                id="genero"
                                name="genero"
                                required>

                                <option value="">
                                    Selecione um gênero
                                </option>

                                <option value="Drama">Drama</option>
                                <option value="Comédia">Comédia</option>
                                <option value="Romance">Romance</option>
                                <option value="Ficção Científica">
                                    Ficção Científica
                                </option>
                                <option value="Terror">Terror</option>
                                <option value="Suspense">Suspense</option>
                                <option value="Fantasia">Fantasia</option>

                            </select>

                        </div>

                    </div>

                    <div class="field">

                        <label for="descricao">
                            Sinopse / descrição
                            <span class="required">*</span>
                        </label>

                        <textarea
                            id="descricao"
                            name="descricao"
                            rows="6"
                            maxlength="3000"
                            placeholder="Conte sobre o universo, os personagens, o conflito principal e o que torna sua história única..."
                            required></textarea>

                        <div class="textarea-bottom">

                            <small class="field-hint">
                                Desperte a curiosidade de
                                possíveis compradores.
                            </small>

                            <span class="counter">
                                <span id="descricaoCount">0</span>/3000
                            </span>

                        </div>

                    </div>

                </section>

                <!-- SEÇÃO 2 -->
                <section class="form-section">

                    <div class="section-header">

                        <div class="section-icon">
                            <i class="bi bi-currency-dollar"></i>
                        </div>

                        <div>
                            <h2>Informações comerciais</h2>
                            <p>
                                Defina o valor de comercialização
                                e a disponibilidade do roteiro.
                            </p>
                        </div>

                    </div>

                    <div class="field-grid">

                        <div class="field">

                            <label for="valor">
                                Preço (R$)
                                <span class="required">*</span>
                            </label>

                            <input
                                type="number"
                                id="valor"
                                name="valor"
                                min="0"
                                step="0.01"
                                placeholder="Ex.: 250.00"
                                required>

                            <small class="field-hint">
                                Informe o preço em reais.
                            </small>

                        </div>

                        <div class="field">

                      

                    </div>

                </section>

                <!-- SEÇÃO 3 -->
                <section class="form-section">

                    <div class="section-header">

                        <div class="section-icon">
                            <i class="bi bi-image"></i>
                        </div>

                        <div>
                            <h2>Identidade visual</h2>
                            <p>
                                Adicione uma capa para apresentar
                                visualmente seu projeto.
                            </p>
                        </div>

                    </div>

                    <div class="field">

                        <label for="imagem">
                            Capa do roteiro
                        </label>

                        <label class="upload-area" id="uploadArea">

                            <i class="bi bi-cloud-arrow-up"></i>

                            <strong>
                                Clique para selecionar uma imagem
                            </strong>

                            <span>
                                JPG, PNG ou WEBP
                            </span>

                            <input
                                type="file"
                                id="imagem"
                                name="imagem"
                                accept="image/jpeg,image/png,image/webp">

                        </label>

                        <p class="file-name" id="fileName">
                            Nenhuma imagem selecionada
                        </p>

                        <small class="field-hint">
                            A imagem aparecerá na capa
                            do roteiro no catálogo do TAKES.
                        </small>

                    </div>

                </section>

                <!-- AÇÕES -->
                <div class="form-actions">

                    <a
                        href="/admin/produtos"
                        class="btn-cancel">

                        <i class="bi bi-x-lg"></i>
                        Cancelar

                    </a>

                    <button
                        type="submit"
                        id="btnPublicar"
                        class="btn-publish">

                        <i class="bi bi-arrow-up-right-circle"></i>
                        Publicar roteiro

                    </button>

                </div>

            </form>

            <!-- PRÉVIA DO CARD -->
            <aside class="preview-column">

                <div class="preview-heading">

                    <h2>Prévia do roteiro</h2>

                    <span class="preview-label">
                        <i class="bi bi-eye"></i>
                        VISUALIZAÇÃO
                    </span>

                </div>

                <article class="preview-card">

                    <div class="poster" id="poster">

                        <div
                            class="poster-placeholder"
                            id="posterPlaceholder">

                            <i class="bi bi-camera-reels"></i>

                            <span>TAKES ORIGINAL</span>

                        </div>

                        <img
                            id="previewImage"
                            alt="Prévia da capa selecionada"
                            hidden>

                    </div>

                    <div class="preview-content">

                        <h3 id="previewTitle">
                            Título do seu roteiro
                        </h3>

                        <p class="preview-author">
                            <i class="bi bi-person-circle"></i>
                            TAKES Creator
                        </p>

                        <p
                            class="preview-description"
                            id="previewDescription">

                            Sua sinopse aparecerá aqui
                            enquanto você preenche
                            o formulário.

                        </p>

                        <div class="preview-tags">

                            <span id="previewGenre">
                                Gênero
                            </span>

                            <span id="previewFormat">
                                Formato
                            </span>

                        </div>

                        <div class="preview-footer">

                            <div class="preview-price">

                                <small>Valor do roteiro</small>

                                <strong id="previewPrice">
                                    R$ 0,00
                                </strong>

                            </div>

                            <span class="preview-view">
                                Ver roteiro
                                <i class="bi bi-arrow-up-right"></i>
                            </span>

                        </div>

                    </div>

                </article>

                <div class="preview-note">

                    <i class="bi bi-info-circle"></i>

                    <span>
                        Esta é apenas uma prévia.
                        Seu roteiro será cadastrado no
                        banco de dados quando você clicar
                        em <strong>Publicar roteiro</strong>.
                    </span>

                </div>

            </aside>

        </div>

    </main>

</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {

        const nome = document.getElementById('nome');
        const categoria = document.getElementById('categoria');
        const genero = document.getElementById('genero');
        const descricao = document.getElementById('descricao');
        const valor = document.getElementById('valor');
        const imagem = document.getElementById('imagem');

        const previewTitle =
            document.getElementById('previewTitle');

        const previewFormat =
            document.getElementById('previewFormat');

        const previewGenre =
            document.getElementById('previewGenre');

        const previewDescription =
            document.getElementById('previewDescription');

        const previewPrice =
            document.getElementById('previewPrice');

        const previewImage =
            document.getElementById('previewImage');

        const posterPlaceholder =
            document.getElementById('posterPlaceholder');

        const descricaoCount =
            document.getElementById('descricaoCount');

        const fileName =
            document.getElementById('fileName');

        const uploadArea =
            document.getElementById('uploadArea');

        const form =
            document.getElementById('formRoteiro');

        const btnPublicar =
            document.getElementById('btnPublicar');

        let imagemURL = null;

        function atualizarPreview() {

            previewTitle.textContent =
                nome.value.trim() ||
                'Título do seu roteiro';

            previewDescription.textContent =
                descricao.value.trim() ||
                'Sua sinopse aparecerá aqui enquanto você preenche o formulário.';

            previewFormat.textContent =
                categoria.value ||
                'Formato';

            previewGenre.textContent =
                genero.value ||
                'Gênero';

            const preco = Number(valor.value || 0);

            previewPrice.textContent =
                preco.toLocaleString('pt-BR', {
                    style: 'currency',
                    currency: 'BRL'
                });

            descricaoCount.textContent =
                descricao.value.length;

        }

        [
            nome,
            categoria,
            genero,
            descricao,
            valor
        ].forEach(elemento => {

            elemento.addEventListener(
                'input',
                atualizarPreview
            );

            elemento.addEventListener(
                'change',
                atualizarPreview
            );

        });

        // PRÉ-VISUALIZAÇÃO DA IMAGEM

        imagem.addEventListener('change', () => {

            const arquivo = imagem.files[0];

            if (imagemURL) {
                URL.revokeObjectURL(imagemURL);
                imagemURL = null;
            }

            if (!arquivo) {

                previewImage.hidden = true;
                previewImage.removeAttribute('src');
                posterPlaceholder.hidden = false;

                fileName.textContent =
                    'Nenhuma imagem selecionada';

                return;
            }

            if (![
                'image/jpeg',
                'image/png',
                'image/webp'
            ].includes(arquivo.type)) {

                alert('Selecione uma imagem JPG, PNG ou WEBP.');

                imagem.value = '';

                previewImage.hidden = true;
                previewImage.removeAttribute('src');
                posterPlaceholder.hidden = false;

                fileName.textContent =
                    'Nenhuma imagem selecionada';

                return;
            }

            imagemURL = URL.createObjectURL(arquivo);

            previewImage.src = imagemURL;
            previewImage.hidden = false;
            posterPlaceholder.hidden = true;

            fileName.textContent = arquivo.name;

        });

        // DESTAQUE NO UPLOAD

        uploadArea.addEventListener('dragover', evento => {
            evento.preventDefault();
            uploadArea.classList.add('dragging');
        });

        uploadArea.addEventListener('dragleave', () => {
            uploadArea.classList.remove('dragging');
        });

        uploadArea.addEventListener('drop', evento => {
            evento.preventDefault();
            uploadArea.classList.remove('dragging');

            if (evento.dataTransfer.files.length > 0) {
                try {
                    imagem.files = evento.dataTransfer.files;
                    imagem.dispatchEvent(new Event('change'));
                } catch (erro) {
                    console.warn('Não foi possível carregar o arquivo arrastado.', erro);
                }
            }
        });

        // PUBLICAÇÃO

        form.addEventListener('submit', evento => {

            if (!form.checkValidity()) {
                evento.preventDefault();
                form.reportValidity();
                return;
            }

            btnPublicar.disabled = true;
            btnPublicar.innerHTML =
                '<i class="bi bi-hourglass-split"></i> Publicando...';

        });

        atualizarPreview();

    });
</script>

</body>
</html>
