
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Editar Roteiro | TAKES</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<main class="container py-5">
    <div class="card shadow-sm mx-auto" style="max-width:750px;">

        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">Editar roteiro</h4>
        </div>

        <div class="card-body">
            <form action="/admin/produtos/editar/<%= produto.id %>"
                  method="POST"
                  enctype="multipart/form-data">

                <div class="mb-3">
                    <label class="form-label">Nome do roteiro</label>
                    <input type="text" name="nome" class="form-control"
                           value="<%= produto.nome %>" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Categoria</label>
                    <select name="categoria" class="form-select">
                        <option value="">Selecione</option>

                        <% categorias.forEach(categoria => { %>
                            <option value="<%= categoria.nome %>"
                                <%= produto.categoria === categoria.nome ? 'selected' : '' %>>
                                <%= categoria.nome %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Gênero</label>
                    <input type="text" name="genero" class="form-control"
                           value="<%= produto.genero || '' %>">
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Valor (R$)</label>
                        <input type="number" name="valor" step="0.01"
                               min="0" class="form-control"
                               value="<%= produto.valor %>">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Estoque</label>
                        <input type="number" name="estoque" min="0"
                               class="form-control"
                               value="<%= produto.estoque %>">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Descrição</label>
                    <textarea name="descricao" class="form-control"
                              rows="5"><%= produto.descricao || '' %></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Imagem</label>

                    <% if (produto.imagem) { %>
                        <div class="mb-3">
                            <img src="/uploads/<%= produto.imagem %>"
                                 alt="Imagem atual"
                                 style="max-width:200px;border-radius:10px;">
                        </div>
                    <% } %>

                    <input type="file" name="imagem"
                           accept="image/*" class="form-control">

                    <small class="text-muted">
                        Se não escolher outra imagem, a atual será mantida.
                    </small>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Salvar alterações
                    </button>

                    <a href="/admin/produtos" class="btn btn-secondary">
                        Cancelar
                    </a>
                </div>

            </form>
        </div>
    </div>
</main>

</body>
</html>
