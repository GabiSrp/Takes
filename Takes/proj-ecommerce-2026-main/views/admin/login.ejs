<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#090d17">
    <meta name="description" content="Entre na sua conta TAKES para descobrir e publicar roteiros.">
    <title>Entrar | TAKES</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body class="takes-login-page">

    <header class="login-header">
        <a class="login-brand" href="/" aria-label="TAKES - Página inicial">
            TAKES <i class="bi bi-camera-reels-fill" aria-hidden="true"></i>
        </a>
        <a href="/" class="login-back">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Voltar para a Home
        </a>
    </header>

    <main class="login-main">
        <section class="login-card" aria-labelledby="login-heading">

            <!-- FORMULÁRIO -->
            <div class="login-form-side">
                <div class="login-form-content">
                    <div class="login-eyebrow">
                        <span class="login-dot" aria-hidden="true"></span>
                        BEM-VINDO AO TAKES
                    </div>

                    <h1 id="login-heading">Sua próxima<br>história começa <span>aqui.</span></h1>
                    <p class="login-description">
                        Entre na sua conta para explorar roteiros, acompanhar seus projetos e continuar criando.
                    </p>

                    <!-- Preserva a rota e os nomes de campo do seu formulário atual -->
                    <form action="/admin/login" method="POST" class="login-form">
                        <div class="login-field">
                            <label for="usuario">E-mail ou nome de usuário</label>
                            <div class="login-input-wrap">
                                <i class="bi bi-person" aria-hidden="true"></i>
                                <input
                                    id="usuario"
                                    name="usuario"
                                    type="text"
                                    placeholder="Seu usuário ou e-mail"
                                    autocomplete="username"
                                    maxlength="254"
                                    required>
                            </div>
                        </div>

                        <div class="login-field">
                            <label for="senha">Senha</label>
                            <div class="login-input-wrap">
                                <i class="bi bi-lock" aria-hidden="true"></i>
                                <input
                                    id="senha"
                                    name="senha"
                                    type="password"
                                    placeholder="Digite sua senha"
                                    autocomplete="current-password"
                                    required>
                                <button
                                    type="button"
                                    class="login-show-password"
                                    id="login-toggle-password"
                                    aria-label="Mostrar senha"
                                    aria-pressed="false"
                                    title="Mostrar ou ocultar senha">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="login-submit">
                            <span>Entrar na minha conta</span>
                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </button>
                    </form>

                    <p class="login-register">
                        Ainda não tem conta?
                        <a href="/cadastro">Cadastre-se gratuitamente</a>
                    </p>
                </div>

                <div class="login-form-footer">
                    <span><i class="bi bi-camera-reels" aria-hidden="true"></i> Do roteiro ao resultado.</span>
                    <span>TAKES · 2026</span>
                </div>
            </div>

            <!-- IMAGEM DO HITCHCOCK -->
            <div class="login-photo-side">
                <img
                    src="/uploads/hitchcock-login.jpg"
                    alt="Fotografia em preto e branco de um cineasta segurando uma claquete"
                    class="login-photo">
                <div class="login-photo-overlay" aria-hidden="true"></div>

                <div class="login-photo-top">
                    <span class="login-photo-label">
                        <i class="bi bi-film" aria-hidden="true"></i>
                        TAKES ORIGINAL
                    </span>
                    <span class="login-photo-number">01 / 01</span>
                </div>

                <div class="login-photo-bottom">
                    <span class="login-photo-line" aria-hidden="true"></span>
                    <h2>Toda grande obra<br>começa com uma <em>ideia.</em></h2>
                    <p>Escreva. Compartilhe. Faça arte.</p>
                </div>
            </div>
        </section>
    </main>

    <script>
        const botaoSenha = document.getElementById('login-toggle-password');
        const campoSenha = document.getElementById('senha');

        botaoSenha.addEventListener('click', () => {
            const visivel = campoSenha.type === 'password';
            campoSenha.type = visivel ? 'text' : 'password';
            botaoSenha.setAttribute('aria-pressed', String(visivel));
            botaoSenha.setAttribute('aria-label', visivel ? 'Ocultar senha' : 'Mostrar senha');
            botaoSenha.querySelector('i').className = visivel ? 'bi bi-eye-slash' : 'bi bi-eye';
        });
    </script>
</body>
</html>
