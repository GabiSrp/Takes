
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Explorar Roteiros | TAKES</title>

    <link rel="stylesheet" href="/css/roteiros.css">

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

<div class="layout">

    <!-- MENU LATERAL -->
    <aside class="sidebar">

        <a href="/" class="logo">
            TAKES
            <i class="bi bi-camera-reels-fill"></i>
        </a>

        <nav class="menu">

            <!-- INÍCIO -->
            <a href="/roteiros" class="menu-item active">
                <i class="bi bi-house-door"></i>
                <span>Início</span>
            </a>

            <!-- FAVORITOS -->
            <a href="#favoritos" class="menu-item">
                <i class="bi bi-star"></i>
                <span>Favoritos</span>
            </a>

            <!-- CARRINHO -->
            <a href="#carrinho" class="menu-item">
                <i class="bi bi-cart3"></i>
                <span>Carrinho</span>
            </a>

            <!-- PERFIL -->
            <a href="/perfil" class="menu-item">
                <i class="bi bi-person"></i>
                <span>Perfil</span>
            </a>

        </nav>

    </aside>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="main-content">

        <!-- BARRA DE PESQUISA -->
        <div class="search-container">

            <i class="bi bi-search"></i>

            <input
                type="search"
                id="pesquisa"
                placeholder="Buscar por roteiros, criadores ou palavras-chave..."
                aria-label="Pesquisar roteiros">

        </div>

        <!-- TÍTULO -->
        <div class="explorar-heading">

            <p class="section-eyebrow">
                DESCUBRA NOVAS HISTÓRIAS
            </p>

            <h1>
                Explorar roteiros<span>.</span>
            </h1>

            <p>
                Histórias originais esperando para ganhar vida.
            </p>

        </div>

        <!-- ABAS E PUBLICAÇÃO -->
        <section class="feed-header">

            <div class="tabs">

                <button
                    type="button"
                    class="tab active"
                    data-tab="todos">
                    Para você
                </button>

                <button
                    type="button"
                    class="tab"
                    data-tab="recentes">
                    Recentes
                </button>

            </div>

            <div class="create-post">

                <div class="avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div class="post-input">

                    <span>
                        Tem uma história para compartilhar?
                    </span>

                    <a
                        href="/admin/produtos/form-cadastrar"
                        class="publish-link">
                        Publicar
                    </a>

                </div>

            </div>

        </section>

        <!-- ROTEIROS CADASTRADOS NO BANCO -->
        <section class="feed" id="feed">

            <% if (produtos.length === 0) { %>

                <div class="empty-feed">

                    <i class="bi bi-camera-reels"></i>

                    <h2>
                        Nenhum roteiro cadastrado
                    </h2>

                    <p>
                        As próximas histórias aparecerão aqui.
                    </p>

                </div>

            <% } %>

            <% produtos.forEach(produto => { %>

                <article
                    class="post roteiro-card"
                    data-id="<%= produto.id %>">

                    <!-- AUTOR -->
                    <div class="post-author">

                        <div class="avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <div class="author-info">

                            <h3>TAKES Creator</h3>

                            <small>
                                <i class="bi bi-film"></i>
                                Roteiro #<%= produto.id %>
                            </small>

                        </div>

                        <span class="post-status">
                            <i class="bi bi-circle-fill"></i>
                            Publicado
                        </span>

                    </div>

                    <!-- TÍTULO -->
                    <h2 class="roteiro-title">
                        <%= produto.nome %>
                    </h2>

                    <!-- CAPA DO ROTEIRO -->
                    <a
                        class="cover-link"
                        href="/roteiros/<%= produto.id %>"
                        aria-label="Ver roteiro <%= produto.nome %>">

                        <% if (produto.imagem) { %>

                            <img
                                class="post-image"
                                src="/uploads/<%= encodeURIComponent(produto.imagem) %>"
                                alt="Capa de <%= produto.nome %>"
                                loading="lazy">

                        <% } else { %>

                            <div class="cover-placeholder">

                                <i class="bi bi-camera-reels"></i>

                                <span>
                                    TAKES ORIGINAL
                                </span>

                            </div>

                        <% } %>

                    </a>

                    <!-- DESCRIÇÃO -->
                    <% if (produto.descricao) { %>

                        <p class="roteiro-description">
                            <%= produto.descricao %>
                        </p>

                    <% } %>

                    <!-- GÊNERO E FORMATO -->
                    <div class="tags">

                        <% if (produto.genero) { %>

                            <span>
                                <%= produto.genero %>
                            </span>

                        <% } %>

                        <% if (produto.categoria) { %>

                            <span>
                                <%= produto.nome_categoria ||
                                    produto.categoria %>
                            </span>

                        <% } %>

                        <span>
                            Roteiro
                        </span>

                    </div>

                    <!-- VALOR E BOTÃO VER ROTEIRO -->
                    <div class="roteiro-footer">

                        <div class="roteiro-price">

                            <small>
                                Valor do roteiro
                            </small>

                            <strong>
                                R$ <%= Number(produto.valor || 0)
                                    .toFixed(2)
                                    .replace('.', ',') %>
                            </strong>

                        </div>

                        <a
                            href="/roteiros/<%= produto.id %>"
                            class="view-button">

                            Ver roteiro

                            <i class="bi bi-arrow-up-right"></i>

                        </a>

                    </div>

                </article>

            <% }); %>

        </section>

        <!-- SEM RESULTADOS -->
        <div
            id="semResultados"
            class="empty-feed"
            style="display:none;">

            <i class="bi bi-search"></i>

            <h2>
                Nenhum resultado encontrado
            </h2>

            <p>
                Tente pesquisar outro termo.
            </p>

        </div>

    </main>

    <!-- PAINEL DIREITO -->
    <aside class="right-sidebar">

        <!-- COMUNIDADE -->
        <section class="widget creators">

            <h3>
                Criadores que você segue
            </h3>

            <div class="creator">

                <div class="avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div>
                    <strong>Buddy_Creator</strong>
                    <small>Roteirista</small>
                </div>

            </div>

            <div class="creator">

                <div class="avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div>
                    <strong>Buddy_Creator2</strong>
                    <small>Roteirista</small>
                </div>

            </div>

            <div class="creator">

                <div class="avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div>
                    <strong>Buddy_Creator3</strong>
                    <small>Roteirista</small>
                </div>

            </div>

        </section>

        <!-- BIBLIOTECA -->
        <section class="widget trends">

            <h3>
                Roteiros disponíveis
            </h3>

            <p class="library-counter">

                <strong>
                    <%= produtos.length %>
                </strong>

                roteiro(s) cadastrado(s)

            </p>

        </section>

        <!-- PUBLICAR -->
        <section class="promo">

            <i class="bi bi-camera-reels-fill"></i>

            <p>
                Publique seus roteiros<br>
                e alcance novos públicos.
            </p>

            <a
                href="/admin/produtos/form-cadastrar"
                class="promo-action">

                Começar agora

            </a>

        </section>

    </aside>

</div>

<!-- JAVASCRIPT -->
<script>

    // ELEMENTOS
    const pesquisa = document.getElementById('pesquisa');

    const feed = document.getElementById('feed');

    const cards = [
        ...document.querySelectorAll('.roteiro-card')
    ];

    const vazio = document.getElementById('semResultados');

    const tabs = document.querySelectorAll('.tab');

    // NORMALIZAR TEXTO
    function normalizar(texto) {

        return texto
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '');

    }

    // PESQUISAR ROTEIROS
    function filtrar() {

        const termo = normalizar(
            pesquisa.value.trim()
        );

        let encontrados = 0;

        cards.forEach(card => {

            const texto = normalizar(
                card.textContent
            );

            const visivel = texto.includes(termo);

            card.hidden = !visivel;

            if (visivel) {
                encontrados++;
            }

        });

        vazio.style.display =
            cards.length > 0 && encontrados === 0
                ? 'block'
                : 'none';

    }

    pesquisa.addEventListener(
        'input',
        filtrar
    );

    // ALTERNAR ABAS
    tabs.forEach(tab => {

        tab.addEventListener('click', () => {

            tabs.forEach(item => {
                item.classList.remove('active');
            });

            tab.classList.add('active');

            const recentes =
                tab.dataset.tab === 'recentes';

            const ordenados = [...cards].sort((a, b) => {

                const idA = Number(a.dataset.id);
                const idB = Number(b.dataset.id);

                return recentes
                    ? idB - idA
                    : idA - idB;

            });

            ordenados.forEach(card => {
                feed.appendChild(card);
            });

            filtrar();

        });

    });

</script>

</body>
</html>
