
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Explorar Roteiros | TAKES</title>

    <link rel="stylesheet" href="/css/roteiros.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* Ajustes específicos da página de roteiros */

        .layout:has(> .right-sidebar) {
            grid-template-columns: 220px minmax(0, 1fr) 300px !important;
        }

        .layout > .right-sidebar {
            grid-column: 3;
            min-width: 0;
        }

        .roteiro-card {
            position: relative;
        }

        .botao-favorito {
            position: absolute;
            top: 25px;
            right: 25px;
            z-index: 5;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            background: #151b29;
            color: #6b9cfa;
            border: 1px solid #38455b;
            border-radius: 50%;
            font-size: 20px;
            cursor: pointer;
            transition: background .25s ease, transform .25s ease;
        }

        .botao-favorito:hover {
            background: #233557;
            transform: scale(1.1);
        }

        .botao-favorito.favoritado {
            background: #182c50;
        }

        .roteiro-card[hidden] {
            display: none !important;
        }

        .cart-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 11px 15px;
            background: #17243c;
            color: #6b9cfa;
            border: 1px solid #345281;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: background .25s ease, transform .25s ease;
        }

        .cart-button:hover {
            background: #254373;
            color: white;
            transform: translateY(-2px);
        }

        .cart-button i {
            font-size: 17px;
        }

        .roteiro-footer {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .roteiro-price {
            margin-right: auto;
        }

        @media (max-width: 1150px) {
            .layout:has(> .right-sidebar) {
                grid-template-columns: 220px minmax(0, 1fr) !important;
            }

            .layout > .right-sidebar {
                display: none;
            }
        }

        @media (max-width: 850px) {
            .layout:has(> .right-sidebar) {
                grid-template-columns: minmax(0, 1fr) !important;
            }

            .botao-favorito {
                top: 12px;
                right: 12px;
            }
        }
    </style>
</head>
<body>

<div class="layout">

    <!-- MENU LATERAL -->
    <aside class="sidebar">
        <a href="/" class="logo">
            TAKES
            <i class="bi bi-camera-reels-fill"></i>
        </a>

        <nav class="menu">
            <a href="/roteiros" class="menu-item active" aria-current="page">
                <i class="bi bi-house-door"></i>
                <span>Início</span>
            </a>

            <a href="/perfil" class="menu-item">
                <i class="bi bi-person"></i>
                <span>Perfil</span>
            </a>

            <a href="/favoritos" class="menu-item">
                <i class="bi bi-star"></i>
                <span>Favoritos</span>
            </a>

            <a href="#carrinho" class="menu-item">
                <i class="bi bi-cart3"></i>
                <span>Carrinho</span>
            </a>
        </nav>
    </aside>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="main-content">

        <div class="search-container">
            <i class="bi bi-search"></i>
            <input
                type="search"
                id="pesquisa"
                placeholder="Buscar por roteiros, criadores ou palavras-chave..."
                aria-label="Pesquisar roteiros">
        </div>

        <div class="explorar-heading">
            <p class="section-eyebrow">DESCUBRA NOVAS HISTÓRIAS</p>
            <h1>Explorar roteiros<span>.</span></h1>
            <p>Histórias originais esperando para ganhar vida.</p>
        </div>

        <!-- ABAS -->
        <section class="feed-header">
            <div class="tabs">
                <button type="button" class="tab active" data-tab="todos">
                    Para você
                </button>

                <button type="button" class="tab" data-tab="recentes">
                    Recentes
                </button>
            </div>

            <div class="create-post">
                <div class="avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div class="post-input">
                    <span>Tem uma história para compartilhar?</span>

                    <a href="/admin/produtos/form-cadastrar" class="publish-link">
                        Publicar
                    </a>
                </div>
            </div>
        </section>

        <!-- ROTEIROS DO SQLITE -->
        <section class="feed" id="feed">

            <% if (produtos.length === 0) { %>
                <div class="empty-feed">
                    <i class="bi bi-camera-reels"></i>
                    <h2>Nenhum roteiro cadastrado</h2>
                    <p>As próximas histórias aparecerão aqui.</p>
                </div>
            <% } %>

            <% produtos.forEach(produto => { %>

                <article
                    class="post roteiro-card"
                    data-id="<%= produto.id %>">

                    <!-- ESTRELA DE FAVORITOS -->
                    <button
                        type="button"
                        class="botao-favorito"
                        data-favorite-id="<%= produto.id %>"
                        aria-label="Adicionar aos favoritos"
                        aria-pressed="false"
                        title="Adicionar aos favoritos">
                        <i class="bi bi-star"></i>
                    </button>

                    <div class="post-author">
                        <div class="avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <div class="author-info">
                            <h3>TAKES Creator</h3>
                            <small>
                                <i class="bi bi-film"></i>
                                Roteiro #<%= produto.id %>
                            </small>
                        </div>

                        <span class="post-status">
                            <i class="bi bi-circle-fill"></i>
                            Publicado
                        </span>
                    </div>

                    <h2 class="roteiro-title">
                        <%= produto.nome %>
                    </h2>

                    <!-- CAPA -->
                    <a
                        class="cover-link"
                        href="/roteiros/<%= produto.id %>"
                        aria-label="Ver roteiro <%= produto.nome %>">

                        <% if (produto.imagem) { %>
                            <img
                                class="post-image"
                                src="/uploads/<%= encodeURIComponent(produto.imagem) %>"
                                alt="Capa de <%= produto.nome %>"
                                loading="lazy">
                        <% } else { %>
                            <div class="cover-placeholder">
                                <i class="bi bi-camera-reels"></i>
                                <span>TAKES ORIGINAL</span>
                            </div>
                        <% } %>
                    </a>

                    <% if (produto.descricao) { %>
                        <p class="roteiro-description">
                            <%= produto.descricao %>
                        </p>
                    <% } %>

                    <!-- TAGS -->
                    <div class="tags">
                        <% if (produto.genero) { %>
                            <span><%= produto.genero %></span>
                        <% } %>

                        <% if (produto.categoria) { %>
                            <span>
                                <%= produto.nome_categoria || produto.categoria %>
                            </span>
                        <% } %>

                        <span>Roteiro</span>
                    </div>

                    <!-- PREÇO E AÇÕES -->
                    <div class="roteiro-footer">

                        <div class="roteiro-price">
                            <small>Valor do roteiro</small>
                            <strong>
                                R$ <%= Number(produto.valor || 0).toFixed(2).replace('.', ',') %>
                            </strong>
                        </div>

                        <!-- VER ROTEIRO PRESERVADO -->
                        <a
                            href="/roteiros/<%= produto.id %>"
                            class="view-button">
                            Ver roteiro
                            <i class="bi bi-arrow-up-right"></i>
                        </a>

                        <!-- CARRINHO APENAS VISUAL -->
                        <button type="button" class="cart-button">
                            <i class="bi bi-cart-plus"></i>
                            Adicionar ao carrinho
                        </button>

                    </div>

                </article>
            <% }); %>

        </section>

        <div id="semResultados" class="empty-feed" style="display:none;">
            <i class="bi bi-search"></i>
            <h2>Nenhum resultado encontrado</h2>
            <p>Tente pesquisar outro termo.</p>
        </div>

    </main>

    <!-- PAINEL DIREITO -->
    <aside class="right-sidebar">

        <section class="widget creators">
            <h3>Criadores que você segue</h3>

            <div class="creator">
                <div class="avatar"><i class="bi bi-person-fill"></i></div>
                <div>
                    <strong>Buddy_Creator</strong>
                    <small>Roteirista</small>
                </div>
            </div>

            <div class="creator">
                <div class="avatar"><i class="bi bi-person-fill"></i></div>
                <div>
                    <strong>Buddy_Creator2</strong>
                    <small>Roteirista</small>
                </div>
            </div>

            <div class="creator">
                <div class="avatar"><i class="bi bi-person-fill"></i></div>
                <div>
                    <strong>Buddy_Creator3</strong>
                    <small>Roteirista</small>
                </div>
            </div>
        </section>

        <section class="widget trends">
            <h3>Roteiros disponíveis</h3>
            <p class="library-counter">
                <strong><%= produtos.length %></strong>
                roteiro(s) cadastrado(s)
            </p>
        </section>

        <section class="promo">
            <i class="bi bi-camera-reels-fill"></i>
            <p>Publique seus roteiros e alcance novos públicos.</p>
            <a href="/admin/produtos/form-cadastrar" class="promo-action">
                Começar agora
            </a>
        </section>

    </aside>
</div>

<script>
    const pesquisa = document.getElementById('pesquisa');
    const feed = document.getElementById('feed');
    const cards = [...document.querySelectorAll('.roteiro-card')];
    const vazio = document.getElementById('semResultados');
    const tabs = document.querySelectorAll('.tab');

    function normalizar(texto) {
        return String(texto || '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '');
    }

    function filtrar() {
        const termo = normalizar(pesquisa.value.trim());
        let encontrados = 0;

        cards.forEach(card => {
            const visivel = normalizar(card.textContent).includes(termo);
            card.hidden = !visivel;
            if (visivel) encontrados++;
        });

        vazio.style.display =
            cards.length > 0 && encontrados === 0 ? 'block' : 'none';
    }

    pesquisa.addEventListener('input', filtrar);

    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            tabs.forEach(item => item.classList.remove('active'));
            tab.classList.add('active');

            const recentes = tab.dataset.tab === 'recentes';

            const ordenados = [...cards].sort((a, b) => {
                const idA = Number(a.dataset.id);
                const idB = Number(b.dataset.id);
                return recentes ? idB - idA : idA - idB;
            });

            ordenados.forEach(card => feed.appendChild(card));
            filtrar();
        });
    });

    // FAVORITOS
    const CHAVE_FAVORITOS = 'takes_favoritos_v1';

    function obterFavoritos() {
        try {
            const dados = JSON.parse(
                localStorage.getItem(CHAVE_FAVORITOS) || '{}'
            );

            return dados && typeof dados === 'object' &&
                !Array.isArray(dados) ? dados : {};
        } catch {
            return {};
        }
    }

    function atualizarEstrelas() {
        const favoritos = obterFavoritos();

        document.querySelectorAll('.botao-favorito')
            .forEach(botao => {
                const id = botao.dataset.favoriteId;
                const ativo = Boolean(favoritos[id]);

                botao.classList.toggle('favoritado', ativo);
                botao.setAttribute('aria-pressed', String(ativo));

                botao.setAttribute(
                    'aria-label',
                    ativo ? 'Remover dos favoritos' : 'Adicionar aos favoritos'
                );

                botao.title = ativo
                    ? 'Remover dos favoritos'
                    : 'Adicionar aos favoritos';

                botao.querySelector('i').className = ativo
                    ? 'bi bi-star-fill'
                    : 'bi bi-star';
            });
    }

    function alternarFavorito(id) {
        const favoritos = obterFavoritos();

        if (favoritos[id]) {
            delete favoritos[id];
        } else {
            favoritos[id] = Date.now();
        }

        try {
            localStorage.setItem(
                CHAVE_FAVORITOS,
                JSON.stringify(favoritos)
            );
            atualizarEstrelas();
        } catch (erro) {
            console.error(erro);
            alert('Não foi possível salvar o favorito.');
        }
    }

    document.querySelectorAll('.botao-favorito')
        .forEach(botao => {
            botao.addEventListener('click', () => {
                alternarFavorito(botao.dataset.favoriteId);
            });
        });

    window.addEventListener('storage', atualizarEstrelas);
    atualizarEstrelas();
</script>

</body>
</html>
